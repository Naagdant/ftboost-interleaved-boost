VSSD1 /SSDC1 GND DC 1 
XQ1 /SW1 /G1 GND NMOS650V
SSW2 /SW2 GND /FSW2 GND __SSW2
SOD2 /SW2 /NA2 /FOD2 GND __SOD2
XD2 /VOUT /NA2 SICSBD650
XQ2 /SW2 /G2 GND NMOS650V
SOL2 /NLX2 /SW2 /FOL2 GND __SOL2
RFB1 /VOUT /VFB 1.99Meg
VFOD2 /FOD2 GND DC 1 
VFSW2 /FSW2 GND DC 0 
VSSD2 /SSDC2 GND DC 1 
RFB2 /VFB GND 10k
VAUX1 /V3V3 GND DC 3.3 
VDUTY1 /DUTY1 GND DC 0.76 
XDFW1 /NR1 /NFW1 DFAST
XK1 /VIN /NK1 /RLY1 GND G2RL1A
XDZ1 GND /NFW1 TVS100
XRSH1 /NR1 /SNP1 /SNN1 /NS1 RSHUNT10M
XEG1 /G1 GND /DUTY1 /CAR1 PWM_GDRV
VCAR1 /CAR1 GND PULSE( 0 1 0 19.99u 10n 0 20u ) 
VCAR2 /CAR2 GND PULSE( 0 1 10u 19.99u 10n 0 20u ) 
XDFW2 /NR2 /NFW2 DFAST
XDZ2 GND /NFW2 TVS100
XEG2 /G2 GND /DUTY2 /CAR2 PWM_GDRV
XK2 /VIN /NK2 /RLY2 GND G2RL1A
XRSH2 /NR2 /SNP2 /SNN2 /NS2 RSHUNT10M
XU2 /VISO2 /SNP2 /SNN2 /NS2 GND /ISN2 /ISP2 /V3V3 AMC1300
VRLY1 /RLY1 GND DC 12 
XU1 /VISO1 /SNP1 /SNN1 /NS1 GND /ISN1 /ISP1 /V3V3 AMC1300
VISO1 /VISO1 /NS1 DC 5 
RDCR1 /NS1 /NL1 60m
L1 /NL1 /NLX1 1m
SSD1 /NK1 /NR1 /SSDC1 GND __SSD1
VFOL1 /FOL1 GND DC 1 
VISO2 /VISO2 /NS2 DC 5 
SSD2 /NK2 /NR2 /SSDC2 GND __SSD2
L2 /NL2 /NLX2 1m
RDCR2 /NS2 /NL2 60m
VFOL2 /FOL2 GND DC 1 
