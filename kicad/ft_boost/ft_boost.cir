.title KiCad schematic
.include "ft_boost_models.lib"
.model __SSW1 SW
+             vt=0.5
+             ron=10m
+             roff=1G
.model __SOD1 SW
+             vt=0.5
+             ron=1m
+             roff=1G
.model __SOL1 SW
+             vt=0.5
+             ron=1m
+             roff=1G
.model __SSW2 SW
+             vt=0.5
+             ron=10m
+             roff=1G
.model __SOD2 SW
+             vt=0.5
+             ron=1m
+             roff=1G
.model __SOL2 SW
+             vt=0.5
+             ron=1m
+             roff=1G
.model __SSD1 SW
+             vt=0.5
+             ron=20m
+             roff=1G
.model __SSD2 SW
+             vt=0.5
+             ron=20m
+             roff=1G
.tran 50n 80m 0 50n
VFSW1 /FSW1 GND DC 0 
SSW1 /SW1 GND /FSW1 GND __SSW1
SOD1 /SW1 /NA1 /FOD1 GND __SOD1
XD1 /VOUT /NA1 SICSBD650
SOL1 /NLX1 /SW1 /FOL1 GND __SOL1
