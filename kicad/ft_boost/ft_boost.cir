RESR1 /NESR GND 10m
COUT1 /VOUT /NESR 14u
VRLY2 /RLY2 GND DC 12 
VDUTY2 /DUTY2 GND DC 0.76 
VIN1 /VSRC GND DC 48 
CIN1 /VIN GND 100u
